/**
 * 監視Worker兼ステータスページ。cronで10分ごとに監視してD1に保存し、同じWorkerがSPAと /api/* を配信する
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "scp-jp-status",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// 当面は個人アカウント（r74.tech）で公開する。scp-jp.org へ移すときはこのホスト名を差し替える
	"routes": [{ "pattern": "status.r74.tech", "custom_domain": true }],
	"triggers": {
		"crons": ["*/10 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "UPTIMEFLARE_D1",
			"database_name": "uptimeflare_d1",
			"database_id": "46a82e85-6ede-4030-b36d-4c2031bb26ec"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
